# NodeWe production reference stack. Replace every change-me value through a
# secret manager before deployment; this file is an environment contract.
NODEWE_ENV=production
NODEWE_ADMIN_TOKEN=change-me-admin-token
NODEWE_GRANT_SECRET=change-me-grant-secret
NODEWE_DATA_DIR=/var/lib/nodewe-control-plane
NODEWE_STORAGE_BACKEND=postgres
NODEWE_DATABASE_URL=postgres://nodewe:change-me@postgres.internal:5432/nodewe
NODEWE_OIDC_ISSUER=https://sso.example.com/realms/nodewe
NODEWE_OIDC_AUDIENCE=nodewe-control-plane
NODEWE_OIDC_ADMIN_GROUP=/nodewe-admins
NODEWE_KMS_PROVIDER=aws-kms
NODEWE_KMS_KEY_ID=alias/nodewe-production
NODEWE_OIDC_REQUIRED=1
NODEWE_OIDC_HS256_SECRET=change-me-oidc-secret
NODEWE_TLS_CERT=/etc/nodewe/tls/control-plane.crt
NODEWE_TLS_KEY=/etc/nodewe/tls/control-plane.key
NODEWE_TLS_CLIENT_CA=/etc/nodewe/tls/agents-ca.crt
NODEWE_REQUIRE_ENCRYPTED_STORE=1
NODEWE_REQUIRE_SIGNED_GRANTS=1
NODEWE_REQUIRE_APPROVAL_RECORDS=1
# PKCS#8 Ed25519 private key, hex encoded; inject from KMS-backed secret file.
NODEWE_GRANT_SIGNING_KEY=change-me-ed25519-pkcs8-hex
NODEWE_AUDIT_EXPORT_URI=s3://nodewe-audit-production/
