# Copy to /etc/nodewe/agent.env and restrict to root:nodewe-agent 0640.
NODEWE_CONTROL_PLANE=127.0.0.1:8787
NODEWE_NODE_ID=lab-a
NODEWE_SCOPE=/var/lib/nodewe-node-runtime/scope
NODEWE_NODE_TOKEN=replace-with-node-credential
# Alternatively mount the credential in a mode-0600 file. The environment
# value takes precedence.
# NODEWE_NODE_TOKEN_FILE=/run/secrets/nodewe-node-token
# Use the persistent outbound TLS/WebSocket session in production. `polling`
# remains available for compatibility and local diagnostics.
NODEWE_AGENT_TRANSPORT=websocket

# For native mTLS, also configure these and add the corresponding flags to the
# service command or use a local TLS proxy:
# NODEWE_TLS_CA=/etc/nodewe/tls/control-plane-ca.pem
# NODEWE_TLS_CERT=/etc/nodewe/tls/agent-client.pem
# NODEWE_TLS_KEY=/etc/nodewe/tls/agent-client-key.pem
# NODEWE_TLS_SERVER_NAME=control-plane.internal
