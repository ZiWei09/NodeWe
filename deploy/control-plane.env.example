# Copy to /etc/nodewe/control-plane.env and restrict to root:nodewe 0640.
# The service binary enforces all production-only gates when this is set.
NODEWE_ENV=production
NODEWE_BIND=127.0.0.1:8787
NODEWE_ADMIN_TOKEN=replace-with-a-random-secret
# Alternatively mount a mode-0600 file; NODEWE_ADMIN_TOKEN takes precedence.
# NODEWE_ADMIN_TOKEN_FILE=/run/secrets/nodewe-admin-token
NODEWE_GRANT_SECRET=replace-with-an-independent-grant-signing-secret
# Alternatively mount a mode-0600 secret file; NODEWE_GRANT_SECRET takes precedence.
# NODEWE_GRANT_SECRET_FILE=/run/secrets/nodewe-grant-secret
# Production grant signing: provide a PKCS#8 Ed25519 private key as hex. When
# unset, the development HMAC fallback above is used and must not be accepted
# for production enrollment.
# NODEWE_GRANT_SIGNING_KEY=replace-with-pkcs8-ed25519-key-hex
# Or mount the key as a mode-0600 secret file; the environment value wins.
# NODEWE_GRANT_SIGNING_KEY_FILE=/run/secrets/nodewe-grant-signing-key
# During key rotation, optionally retain the previous public-verification key
# material until all outstanding grants expire.
# NODEWE_GRANT_SIGNING_KEY_PREVIOUS_FILE=/run/secrets/nodewe-grant-signing-key-previous
NODEWE_REQUIRE_SIGNED_GRANTS=1
# Require a server-issued, single-use approval record for task.exec.
NODEWE_REQUIRE_APPROVAL_RECORDS=1
# Production OIDC/OAuth2 JWT verification. Pin issuer and audience and inject
# the HS256 verification secret from the identity gateway/secret manager.
NODEWE_OIDC_REQUIRED=1
# NODEWE_OIDC_ISSUER=https://id.example.invalid/
# NODEWE_OIDC_AUDIENCE=nodewe-cli
# NODEWE_OIDC_HS256_SECRET_FILE=/run/secrets/nodewe-oidc-hs256
# NODEWE_OIDC_ADMIN_GROUP=nodewe-admin
# NODEWE_OIDC_GROUP_CLAIM=groups
NODEWE_DATA_DIR=/var/lib/nodewe
# Storage backend: snapshot (default) or transactional sqlite.
# NODEWE_STORAGE_BACKEND=sqlite
# Mark a node offline when no heartbeat has arrived within this interval.
# Keep this above the Agent heartbeat interval plus expected network jitter.
# NODEWE_NODE_ONLINE_TTL_MS=30000
# Optional policy file. The service refuses malformed policy files at startup.
# NODEWE_POLICY_FILE=/etc/nodewe/policy.conf
# 32-byte AES-256-GCM key, encoded as exactly 64 hex characters. Keep it in
# the secret manager; never commit it to this file.
# NODEWE_STORE_KEY=replace-with-64-hex-character-secret
# Alternatively mount a mode-0600 secret file; NODEWE_STORE_KEY takes precedence.
# NODEWE_STORE_KEY_FILE=/run/secrets/nodewe-store-key
NODEWE_REQUIRE_ENCRYPTED_STORE=1
# Optional native TLS/mTLS (all three are required together). If unset, keep
# NODEWE_BIND on loopback and set NODEWE_TLS_PROXY_APPROVED=1 only after the
# approved reverse proxy configuration has been reviewed.
# NODEWE_TLS_PROXY_APPROVED=1
# NODEWE_TLS_CERT=/etc/nodewe/tls/server-chain.pem
# NODEWE_TLS_KEY=/etc/nodewe/tls/server-key.pem
# NODEWE_TLS_CLIENT_CA=/etc/nodewe/tls/agent-ca.pem
